# === Base de donnees ===
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/vetclinic?schema=public"

# === Serveur ===
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Origines autorisées, séparées par des virgules. OBLIGATOIRE en production.
CORS_ORIGIN="http://localhost:3001"
# reverse proxy devant l'API (Nginx/Caddy) : fait remonter X-Forwarded-For
# dans les rate limits. Laisser false en accès direct.
TRUSTED_PROXY=false

# === JWT ===
# OBLIGATOIRE en production : le serveur refuse de demarrer sans cette variable si NODE_ENV=production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# === MinIO (S3-compatible) ===
# OBLIGATOIRE en production : le serveur refuse de demarrer sans ces variables si NODE_ENV=production
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER="change-me-in-production"
MINIO_ROOT_PASSWORD="change-me-in-production"

# === Firebase Cloud Messaging (FCM v1) ===
# Chemin vers le fichier JSON du compte de service Firebase (a telecharger depuis
# Firebase Console > Parametres du projet > Comptes de service > Generer une cle privee).
# Ce fichier est ignore par git (*firebase-adminsdk*.json).
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# === Email (SMTP) ===
# Transport generique (nodemailer) : compatible avec n'importe quel fournisseur
# (Brevo, Mailjet, Resend, Mailtrap, Gmail...). Rien n'est parametre pour un
# fournisseur precis : seules ces 5 variables changent d'un fournisseur a l'autre.
#
# Si SMTP_PASS est vide ou absent, le mailer passe en mode "dry-run" : il
# journalise un resume (destinataire, sujet, presence d'un .ics) sans envoyer
# rien et sans echouer.
#
# En mode test (NODE_ENV=test / VITEST), le transport est simule (jsonTransport,
# aucun acces reseau) et les emails "envoyes" sont inspectables en memoire.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="change-me-in-production"
SMTP_PASS=""
SMTP_FROM="VetClinic <no-reply@example.com>"

# === Google Sign-In ===
# Creer des credentials OAuth 2.0 dans Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id-here"
