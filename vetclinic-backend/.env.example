# ── Base de données ──
DATABASE_URL="postgresql://vetclinic:REDACTED_DB_PASSWORD@127.0.0.1:5433/vetclinic?schema=public"

# ── Serveur ──
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN="http://localhost:3001"

# ── JWT ──
# OBLIGATOIRE en production — le serveur refuse de démarrer sans cette variable si NODE_ENV=production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── MinIO (S3-compatible) ──
# OBLIGATOIRE en production — le serveur refuse de démarrer sans ces variables si NODE_ENV=production
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER="REDACTED_MINIO_USER"
MINIO_ROOT_PASSWORD="REDACTED_MINIO_PASSWORD"
