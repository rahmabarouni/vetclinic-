# ── Base de données ──
DATABASE_URL="postgresql://vetclinic:REDACTED_DB_PASSWORD@127.0.0.1:5433/vetclinic?schema=public"

# ── Serveur ──
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN="http://localhost:3001"

# ── JWT ──
# OBLIGATOIRE en production — le serveur refuse de démarrer sans cette variable si NODE_ENV=production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── MinIO (S3-compatible) ──
# OBLIGATOIRE en production — le serveur refuse de démarrer sans ces variables si NODE_ENV=production
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ROOT_USER="REDACTED_MINIO_USER"
MINIO_ROOT_PASSWORD="REDACTED_MINIO_PASSWORD"

# ── Email OTP (SMTP) ──
# Pour le développement, utilise Ethereal : npx ethereal email
# Pour la production, configure ton service SMTP (Mailtrap, SendGrid, etc.)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="test@example.com"
SMTP_PASS="test"

# ── Google Sign-In ──
# Créer des credentials OAuth 2.0 dans Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id-here"
