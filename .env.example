# =====================================================================
#  Docker Compose — variables d'environnement
#  Copiez ce fichier en `.env` (ignoré par git) puis renseignez des
#  valeurs FORTES et UNIQUES. Ne commitez jamais le `.env`.
#
#      Copy-Item .env.example .env      # PowerShell
#      cp .env.example .env             # bash
# =====================================================================

# --- PostgreSQL ---
POSTGRES_USER=vetclinic
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=vetclinic

# --- MinIO ---
MINIO_ROOT_USER=changez-moi
# MinIO exige au moins 8 caractères pour le mot de passe.
MINIO_ROOT_PASSWORD=changez-moi
